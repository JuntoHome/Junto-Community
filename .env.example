# Copy to .env.local for local development. Set real values in Vercel; never commit them.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Google Search Console HTML-tag verification code (the content="..." value only).
GOOGLE_SITE_VERIFICATION=

# Resend: emails the team when someone joins. Without the key, signups still save but no email is sent.
RESEND_API_KEY=
# Optional: who gets the email (comma-separated). Defaults to the site contact email.
SUBSCRIBE_NOTIFY_EMAIL=
# Optional: sender on a domain verified in Resend. Defaults to notifications@juntocommunity.org.
RESEND_FROM_EMAIL=
